<Window x:Class="Lunarune.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lunarune" Width="1100" Height="720" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="34"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#332343" CornerRadius="15"><TextBlock Text="❀" FontSize="26" Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="L U N A R U N E" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/><TextBlock x:Name="Subtitle" FontSize="19" FontWeight="SemiBold"/></StackPanel><ComboBox x:Name="LanguagePicker" Grid.Column="2" Width="120" Height="36" VerticalAlignment="Center" SelectionChanged="LanguagePicker_SelectionChanged"/></Grid>
<StackPanel Grid.Row="1" Margin="0,40,0,18"><TextBlock x:Name="Section" FontSize="10" FontWeight="Bold" Foreground="#C69AE8"/><TextBlock x:Name="Count" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock x:Name="Description" Foreground="{StaticResource MutedBrush}" FontSize="13"/></StackPanel>
<Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="ProfilePath" TextWrapping="Wrap" Foreground="#BEB5CB" FontSize="11"/></Border>
<ListBox x:Name="Profiles" Grid.Row="3" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="14" SelectionChanged="Profiles_SelectionChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="#2B2333"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#51405C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="IB" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="IB" Property="BorderBrush" Value="#F0B2D2"/><Setter TargetName="IB" Property="Background" Value="#3B2A48"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
<StackPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock x:Name="KeepOpen" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12"/><Button x:Name="Launch" Height="48" Background="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" Click="Launch_Click"/><Button x:Name="OpenFolder" Height="40" Margin="0,9,0,0" Click="OpenFolder_Click"/><TextBlock x:Name="RunePath" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,10,0,4"/><Button x:Name="SelectRune" Height="38" FontSize="11" Click="SelectRune_Click"/><Button x:Name="SelectProfiles" Height="38" FontSize="11" Margin="0,8,0,0" Click="SelectProfiles_Click"/><Button x:Name="ImportSettings" Height="34" FontSize="11" Margin="0,8,0,0" Click="ImportSettings_Click"/><TextBlock x:Name="Status" Foreground="{StaticResource AccentLightBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1" Background="#211827" ClipToBounds="True"><Image Source="/Lunarune_Emilia.png" Stretch="UniformToFill" Opacity="0.94"/><Canvas x:Name="Sakura" ClipToBounds="True" IsHitTestVisible="False"/><Border x:Name="Glow" Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.15" IsHitTestVisible="False"><Border.Background><RadialGradientBrush><GradientStop Color="#FFD2E8" Offset="0"/><GradientStop Color="#C88CEA" Offset="0.4"/><GradientStop Color="#00C88CEA" Offset="1"/></RadialGradientBrush></Border.Background><Border.Effect><BlurEffect Radius="42"/></Border.Effect></Border><Border Background="#300A0911"/><Border VerticalAlignment="Bottom" Height="330"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00100D18" Offset="0"/><GradientStop Color="#AE140D1C" Offset="1"/></LinearGradientBrush></Border.Background></Border><StackPanel VerticalAlignment="Bottom" Margin="32,32,32,38"><TextBlock x:Name="Eyebrow" FontSize="10" FontWeight="Bold" Foreground="#E8B9FF"/><TextBlock x:Name="HeroTitle" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="HeroCaption" Foreground="#C2B8CC" FontSize="12" Margin="0,8,0,0"/></StackPanel></Grid>
</Grid></Window>
